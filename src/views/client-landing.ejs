<%- include('partials/top', { title: title }) %>

<section
  class="client-flow-screen single center-landing client-funnel-stage"
  style="--funnel-robot-bg-image: url('/assets/robots/futureeapro-test-lady-cyber.jpg');"
>
  <article class="client-flow-card">
    <div class="client-flow-stepper" aria-hidden="true">
      <span class="active">Identity</span>
      <span>Subscription</span>
      <span>Add License Key</span>
    </div>
    <h1>Future EA Pro Access</h1>
    <p class="client-flow-meta">Enter your mentor ID and client email to continue.</p>

    <form action="/client/start" method="POST" class="stack-form client-flow-form">
      <label>
        Mentor ID
        <input type="number" name="mentorPortalId" min="100" step="1" placeholder="100" required />
      </label>

      <label>
        Client Email
        <input type="email" name="clientEmail" placeholder="name@email.com" required />
      </label>

      <button type="submit" class="button client-flow-button">Continue</button>
    </form>
  </article>
</section>

<%- include('partials/bottom') %>
