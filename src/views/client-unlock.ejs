<%- include('partials/top', { title: title }) %>

<section class="client-flow-screen">
  <article class="client-flow-card">
    <div class="client-flow-stepper" aria-hidden="true">
      <span>Identity</span>
      <span>Subscription</span>
      <span class="active">Add License Key</span>
    </div>
    <h1>Add License Key</h1>
    <p class="client-flow-meta">
      Plan: <strong><%= plan ? plan.label : flow.planCode %></strong> ·
      Amount: <strong>R<%= plan ? plan.amountZar : '-' %></strong>
    </p>
    <p class="client-flow-meta">Client Email: <strong><%= flow.clientEmail %></strong></p>

    <div class="license-glow-box">
      <form action="/client/unlock" method="POST" class="stack-form client-flow-form">
        <label>
          License Key
          <input type="text" name="licenseKey" placeholder="XXXX-XXXX" required />
        </label>
        <input type="hidden" name="deviceId" value="<%= deviceId %>" />

        <button type="submit" class="button client-flow-button">Unlock Robot</button>
      </form>
    </div>
  </article>

  <article class="client-flow-card client-flow-preview">
    <h2>Robot Preview</h2>
    <% if (featuredRobot && featuredRobot.imageUrl) { %>
      <img
        src="<%= featuredRobot.imageUrl %>"
        alt="<%= featuredRobot.name %> preview"
        class="robot-preview-lg robot-preview-feature"
      />
      <p><strong><%= featuredRobot.name %></strong></p>
    <% } else if (featuredRobot) { %>
      <p><strong><%= featuredRobot.name %></strong></p>
      <p class="hint">Robot image not uploaded yet.</p>
    <% } else { %>
      <p class="hint">No robot profile is available yet for this mentor.</p>
    <% } %>
  </article>
</section>

<%- include('partials/bottom') %>
