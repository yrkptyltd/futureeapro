<%- include('partials/top', { title: title }) %>

<section class="dashboard-overview">
  <article class="panel welcome-banner">
    <div class="welcome-icon" aria-hidden="true">📱</div>
    <div>
      <h2>Install Future EA Pro on iPhone</h2>
      <p class="welcome-sub">
        iOS installs as a web app. Follow these quick steps in Safari for the best full-screen experience.
      </p>
    </div>
  </article>
</section>

<section class="panel-grid home-split">
  <article class="panel quick-card">
    <h2>Install Steps</h2>
    <ol class="list">
      <li>Tap <strong>Open Client App</strong> below.</li>
      <li>When Safari opens, tap the <strong>Share</strong> icon.</li>
      <li>Select <strong>Add to Home Screen</strong>.</li>
      <li>Tap <strong>Add</strong> to finish.</li>
      <li>Launch Future EA Pro from your iPhone home screen.</li>
    </ol>
    <div class="cta-row">
      <a class="button" href="/client">Open Client App</a>
      <a class="button secondary" href="/">Back Home</a>
    </div>
  </article>

  <article class="panel quick-card">
    <h2>Need Android?</h2>
    <p>Use the Android APK if you want a direct install package for testing.</p>
    <div class="cta-row">
      <a class="button" href="/download/android">Download Android APK</a>
    </div>
  </article>
</section>

<%- include('partials/bottom') %>
